<div class="profile-page">
  <div class="edit-profile-card">
    <div class="edit-profile-header">
      <h2><i class="bi bi-person-fill-gear"></i> Edit Profile</h2>
      <a href="/profile/{{user._id}}" class="btn-profile btn-edit">
        <i class="bi bi-arrow-left"></i> Back
      </a>
    </div>

    <form
      action="/profile/{{user._id}}?_method=PUT"
      method="POST"
      enctype="multipart/form-data"
      class="edit-form"
    >
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />

      <!-- AVATAR -->
      <div class="avatar-upload">
        <div class="avatar-upload-circle">
          {{#if user.avatar}}
          <img src="{{user.avatar}}" id="avatarPreview" />
          {{else}}
          <div class="avatar-fallback" id="avatarPreview">U</div>
          {{/if}}
          <label class="avatar-upload-btn" for="avatarInput">
            <i class="bi bi-camera-fill"></i>
          </label>
        </div>
        <input
          type="file"
          id="avatarInput"
          name="avatar"
          accept="image/*"
          hidden
        />
        <span class="avatar-hint"
          >Click the camera icon to change your profile picture</span
        >
      </div>

      <!-- NAME -->
      <div class="form-group">
        <label for="nameInput">Display Name</label>
        <input
          id="nameInput"
          name="name"
          class="form-control"
          value="{{user.name}}"
          required
        />
      </div>

      <!-- BIO -->
      <div class="form-group">
        <label for="bioInput">About Me</label>
        <textarea
          id="bioInput"
          name="bio"
          class="form-control"
          rows="4"
          placeholder="Write a few lines about yourself..."
        >
{{user.bio}}</textarea
        >
      </div>

      <div class="edit-form-actions">
        <a href="/profile/{{user._id}}" class="btn-profile btn-cancel"
          >Cancel</a
        >
        <button type="submit" class="btn-profile btn-follow">
          <i class="bi bi-check-lg"></i> Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const avatarInput = document.getElementById('avatarInput');

  avatarInput.addEventListener('change', event => {
    const file = event.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      alert('Vui lòng chọn file hình ảnh!');
      avatarInput.value = '';
      return;
    }
    const url = URL.createObjectURL(file);
    let preview = document.getElementById('avatarPreview');
    // Nếu đang là placeholder (div chữ "U"), thay bằng thẻ img thật
    if (preview.tagName !== 'IMG') {
      const img = document.createElement('img');
      img.id = 'avatarPreview';
      preview.replaceWith(img);
      preview = img;
    }
    preview.src = url;
    preview.onload = () => URL.revokeObjectURL(url);
  });
</script>
