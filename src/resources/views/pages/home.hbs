<div class="dashboard-container mt-4">
  <!-- HEADER -->
  <div class="d-flex justify-content-end align-items-center mb-3">
    <div class="d-flex gap-2">
      <a href="/users" class="btn btn-outline-secondary">👥 Users</a>
      <a href="/tasks/create" class="btn btn-primary">+ Create Post</a>
    </div>
  </div>
  <!-- KPI -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="dashboard-kpi warning">
        <div class="kpi-icon"><i class="bi bi-alarm"></i></div>
        <div class="kpi-content">
          <div class="label">Soon</div>
          <div class="value">{{soonTasks}}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="dashboard-kpi danger">
        <div class="kpi-icon"><i class="bi bi-fire"></i></div>
        <div class="kpi-content">
          <div class="label">Overdue</div>
          <div class="value">{{overdueTasks}}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="dashboard-kpi success">
        <div class="kpi-icon"><i class="bi bi-check-circle"></i></div>
        <div class="kpi-content">
          <div class="label">Done</div>
          <div class="value">{{doneTasks}}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="dashboard-kpi secondary">
        <div class="kpi-icon"><i class="bi bi-trash3"></i></div>
        <div class="kpi-content">
          <div class="label">Trash</div>
          <div class="value">{{trashTask}}</div>
        </div>
      </div>
    </div>
  </div>
  <!-- FEED -->
  {{#each tasks}}
  <div class="card feed-card mb-3 shadow-sm">
    <div class="card-body">
      <!-- USER INFO -->
      <div class="d-flex align-items-center mb-2">
        <div class="avatar me-2">
          <a href="/profile/{{author._id}}">
            <img src="{{author.avatar}}" alt="{{author.name}}" />
          </a>
        </div>
        <div>
          <a href="/profile/{{author._id}}" class="text-decoration-none">
            <strong>{{author.name}}</strong>
          </a>
          <div class="meta">{{timeAgo createdAt}}</div>
        </div>
      </div>
      <!-- TAGS -->
      {{#if tags}}
      <div class="mb-2">
        {{#each tags}}
        <a href="#" class="badge btn-info text-decoration-none"> #{{this}} </a>
        {{/each}}
      </div>
      {{/if}}
      <!-- TITLE -->
      <h5 class="task-title mb-3">
        <a href="/tasks/{{_id}}">{{title}}</a>
      </h5>
      <!-- DESCRIPTION -->
      <p class="mb-2">{{description}}</p>
      <!-- ATTACHMENTS -->
      {{#if attachments}}
      <div class="attachments mb-2">
        {{!-- GRID ẢNH: tối đa 4 ô hiển thị, dư thì hiện +N (xử lý ở JS) --}}
        <div
          class="attachments-grid"
          data-images='[{{#each attachments}}{{#if (includes type "image")}}"{{url}}"{{#unless @last}},{{/unless}}{{/if}}{{/each}}]'
        >
          {{#each attachments}} {{#if (includes type "image")}}
          <div class="attachment-img-item">
            <img src="{{url}}" class="post-img" />
          </div>
          {{/if}} {{/each}}
        </div>
        {{!-- FILE: tách riêng, không tính vào grid ảnh --}} {{#each
        attachments}} {{#unless (includes type "image")}}
        <a href="{{url}}" target="_blank" class="file-link"> 📄 {{name}} </a>
        {{/unless}} {{/each}}
      </div>
      {{/if}}
      <!-- STATUS -->
      <div class="d-flex justify-content-between align-items-center meta mb-2">
        <span class="badge status {{status}}">{{status}}</span>
        <div>
          <i class="bi bi-suit-heart-fill"></i>
          <span id="like-count-{{_id}}">{{likes.length}}</span> •
          <i class="bi bi-chat-left-dots"></i>
          {{commentCount}}
        </div>
      </div>
      <hr />
      <!-- ACTION -->
      <div class="d-flex justify-content-around text-center action-bar">
        <a href="/tasks/{{_id}}" class="text-decoration-none">
          <i class="bi bi-chat-left-dots"></i>
          Comment
        </a>
        <button class="btn-like {{#if isLiked}}liked{{/if}}" data-id="{{_id}}">
          <i class="bi bi-suit-heart-fill"></i>
          <span class="like-text">
            {{#if isLiked}}Liked{{else}}Like{{/if}}
          </span>
        </button>
        <button
          type="button"
          class="btn-view text-decoration-none"
          data-images='[{{#each attachments}}{{#if (includes type "image")}}"{{url}}"{{#unless @last}},{{/unless}}{{/if}}{{/each}}]'
        >
          <i class="bi bi-eye-fill"></i>
          View
        </button>
      </div>
    </div>
  </div>
  {{/each}}
</div>

<!-- LIGHTBOX (dùng chung cho toàn bộ feed) -->
<div class="image-lightbox" id="imageLightbox">
  <button type="button" class="lightbox-close" id="lightboxClose">
    <i class="bi bi-x-lg"></i>
  </button>
  <button type="button" class="lightbox-nav lightbox-prev" id="lightboxPrev">
    <i class="bi bi-chevron-left"></i>
  </button>
  <div class="lightbox-content">
    <img id="lightboxImg" src="" alt="Post image" />
    <div class="lightbox-empty" id="lightboxEmpty" style="display: none">
      <i class="bi bi-image"></i>
      <p>No image for this post</p>
    </div>
    <div class="lightbox-counter" id="lightboxCounter"></div>
  </div>
  <button type="button" class="lightbox-nav lightbox-next" id="lightboxNext">
    <i class="bi bi-chevron-right"></i>
  </button>
</div>

<!-- SCRIPT -->
<script>
  document.querySelectorAll('.btn-like').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      btn.disabled = true;
      try {
        const res = await fetch(`/tasks/${id}/like`, { method: 'POST' });
        const data = await res.json();
        if (!data.success) return;
        const countEl = document.querySelector(`#like-count-${id}`);
        if (countEl) countEl.textContent = data.likeCount;
        btn.classList.toggle('liked', data.liked);
        const textEl = btn.querySelector('.like-text');
        if (textEl) textEl.textContent = data.liked ? 'Liked' : 'Like';
      } catch (err) {
        console.error(err);
      } finally {
        btn.disabled = false;
      }
    });
  });
  // ===== LIGHTBOX (dùng chung toàn trang) =====
  const lightbox = document.getElementById('imageLightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const lightboxEmpty = document.getElementById('lightboxEmpty');
  const lightboxClose = document.getElementById('lightboxClose');
  const lightboxPrev = document.getElementById('lightboxPrev');
  const lightboxNext = document.getElementById('lightboxNext');
  const lightboxCounter = document.getElementById('lightboxCounter');
  let currentImages = [];
  let currentIndex = 0;
  function renderLightbox() {
    if (currentImages.length === 0) {
      lightboxImg.style.display = 'none';
      lightboxEmpty.style.display = 'flex';
      lightboxCounter.style.display = 'none';
      lightboxPrev.style.display = 'none';
      lightboxNext.style.display = 'none';
      return;
    }
    lightboxImg.src = currentImages[currentIndex];
    lightboxImg.style.display = 'block';
    lightboxEmpty.style.display = 'none';
    const hasMultiple = currentImages.length > 1;
    lightboxCounter.style.display = hasMultiple ? 'block' : 'none';
    lightboxCounter.textContent = `${currentIndex + 1} / ${currentImages.length}`;
    // dừng ở đầu/cuối, KHÔNG lặp vòng
    lightboxPrev.style.display =
      hasMultiple && currentIndex > 0 ? 'flex' : 'none';
    lightboxNext.style.display =
      hasMultiple && currentIndex < currentImages.length - 1 ? 'flex' : 'none';
  }
  function openLightbox(images, startIndex = 0) {
    currentImages = images || [];
    currentIndex = startIndex;
    renderLightbox();
    lightbox.classList.add('active');
  }
  function showPrev() {
    if (currentIndex <= 0) return;
    currentIndex -= 1;
    renderLightbox();
  }
  function showNext() {
    if (currentIndex >= currentImages.length - 1) return;
    currentIndex += 1;
    renderLightbox();
  }
  lightboxPrev.addEventListener('click', e => {
    e.stopPropagation();
    showPrev();
  });
  lightboxNext.addEventListener('click', e => {
    e.stopPropagation();
    showNext();
  });
  function closeLightbox() {
    lightbox.classList.remove('active');
    lightboxImg.src = '';
    currentImages = [];
    currentIndex = 0;
  }
  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', e => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', e => {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showPrev();
    if (e.key === 'ArrowRight') showNext();
  });
  // ===== GRID ẢNH: giới hạn 4 ô, dư thì +N, click mở đúng ảnh =====
  document.querySelectorAll('.attachments-grid').forEach(grid => {
    let images = [];
    try {
      images = JSON.parse(grid.dataset.images || '[]');
    } catch (err) {
      images = [];
    }
    const items = Array.from(grid.querySelectorAll('.attachment-img-item'));
    const MAX_VISIBLE = 4;
    if (items.length > MAX_VISIBLE) {
      items.forEach((item, i) => {
        if (i >= MAX_VISIBLE) item.style.display = 'none';
      });
      const extra = items.length - MAX_VISIBLE;
      const overlay = document.createElement('div');
      overlay.className = 'attachment-more';
      overlay.innerHTML = `<span>+${extra}</span>`;
      items[MAX_VISIBLE - 1].appendChild(overlay);
    }
    items.forEach((item, index) => {
      if (index >= MAX_VISIBLE) return;
      item.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        openLightbox(images, index);
      });
    });
  });
  // Nút "View" ở action bar -> mở lightbox từ ảnh đầu
  document.querySelectorAll('.btn-view').forEach(btn => {
    btn.addEventListener('click', () => {
      let images = [];
      try {
        images = JSON.parse(btn.dataset.images || '[]');
      } catch (err) {
        images = [];
      }
      openLightbox(images, 0);
    });
  });
</script>
