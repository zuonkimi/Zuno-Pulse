<div class="theme-page">
  <!-- HEADER -->
  <div class="theme-header">
    <div>
      <h2>Appearance</h2>
      <p>
        Customize the look and feel of your workspace
      </p>
    </div>
    <a
      href="/settings"
      class="theme-back-btn"
    >
      <i class="bi bi-arrow-left"></i>
      Back
    </a>
  </div>

  <!-- CARD -->
  <div class="theme-card">
    {{#if success}}
      <div class="alert alert-success">
        {{success}}
      </div>
    {{/if}}
    {{#if error}}
      <div class="alert alert-danger">
        {{error}}
      </div>
    {{/if}}

    <form
      action="/settings/theme"
      method="POST"
      id="themeForm"
    >
      <input
        type="hidden"
        name="_csrf"
        value="{{csrfToken}}"
      />
      <!-- THEME MODE -->
      <div class="theme-section">
        <div class="theme-section-top">
          <div>
            <h5>Theme Mode</h5>
            <p>
              Choose how the interface should appear
            </p>
          </div>
        </div>
        <select
          name="theme"
          class="theme-select"
        >
          <option
            value="system"
            {{#if (eq user.theme "system")}}selected{{/if}}
          >
            System (Follow OS)
          </option>
          <option
            value="light"
            {{#if (eq user.theme "light")}}selected{{/if}}
          >
            Light
          </option>
          <option
            value="dark"
            {{#if (eq user.theme "dark")}}selected{{/if}}
          >
            Dark
          </option>
        </select>
      </div>
      <!-- ACCENT -->
      <div class="theme-section">
        <div class="theme-section-top">
          <div>
            <h5>Accent Color</h5>
            <p>
              Used for buttons, highlights and links
            </p>
          </div>
        </div>
        <div class="color-picker-wrap">
          <input
            id="accentColor"
            type="color"
            name="accentColor"
            class="theme-color-input"
            value="{{#if user.accentColor}}{{user.accentColor}}{{else}}#00c6ff{{/if}}"
          />
          <div class="color-preview">
            <span
              class="color-dot"
              id="colorDot"
            ></span>
            <span id="colorText">
              {{#if user.accentColor}}
                {{user.accentColor}}
              {{else}}
                #00c6ff
              {{/if}}
            </span>
          </div>
        </div>
      </div>
      <!-- LIVE PREVIEW -->
      <div class="theme-section">
        <div class="theme-section-top">
          <div>
            <h5>Live Preview</h5>
            <p>
              Preview how your selected accent
              color looks
            </p>
          </div>
        </div>
        <div class="theme-preview">
          <!-- CARD -->
          <div class="preview-card">
            <div class="preview-top">
              <div class="preview-avatar"></div>
              <div class="preview-lines">
                <div class="preview-line"></div>
                <div class="preview-line small"></div>
              </div>
            </div>

            <div class="preview-content"></div>
            <button
              type="button"
              class="preview-button"
            >
              Continue
            </button>
          </div>
          <!-- CARD -->
          <div class="preview-card">
            <div class="preview-top">
              <div class="preview-avatar"></div>
              <div class="preview-lines">
                <div class="preview-line"></div>
                <div class="preview-line small"></div>
              </div>
            </div>
            <div class="preview-content"></div>
            <button
              type="button"
              class="preview-button"
            >
              Save Changes
            </button>
          </div>
          <!-- CARD -->
          <div class="preview-card">
            <div class="preview-top">
              <div class="preview-avatar"></div>
              <div class="preview-lines">
                <div class="preview-line"></div>
                <div class="preview-line small"></div>
              </div>
            </div>
            <div class="preview-content"></div>
            <button
              type="button"
              class="preview-button"
            >
              Open
            </button>
          </div>
        </div>
      </div>
      <!-- SAVE -->
      <button
        type="submit"
        class="theme-save-btn"
      >
        <i class="bi bi-check2-circle"></i>
        Save Changes
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener(
    'DOMContentLoaded',
    () => {
      const colorInput =
        document.getElementById(
          'accentColor',
        );

      const themeSelect =
        document.querySelector(
          '.theme-select',
        );

      const colorDot =
        document.getElementById(
          'colorDot',
        );

      const colorText =
        document.getElementById(
          'colorText',
        );

      const previewCards =
        document.querySelectorAll(
          '.preview-card',
        );

      const previewContents =
        document.querySelectorAll(
          '.preview-content',
        );

      const previewLines =
        document.querySelectorAll(
          '.preview-line',
        );

      function shadeColor(
        color,
        percent,
      ) {
        let R = parseInt(
          color.substring(1, 3),
          16,
        );

        let G = parseInt(
          color.substring(3, 5),
          16,
        );

        let B = parseInt(
          color.substring(5, 7),
          16,
        );

        R = parseInt(
          (R * (100 + percent)) / 100,
        );

        G = parseInt(
          (G * (100 + percent)) / 100,
        );

        B = parseInt(
          (B * (100 + percent)) / 100,
        );
        R = R < 255 ? R : 255;
        G = G < 255 ? G : 255;
        B = B < 255 ? B : 255;
        const RR =
          R.toString(16).length === 1
            ? '0' + R.toString(16)
            : R.toString(16);
        const GG =
          G.toString(16).length === 1
            ? '0' + G.toString(16)
            : G.toString(16);
        const BB =
          B.toString(16).length === 1
            ? '0' + B.toString(16)
            : B.toString(16);
        return '#' + RR + GG + BB;
      }

      function applyPreviewTheme(
        theme,
        color,
      ) {
        const isLight =
          theme === 'light';

        const cardBg = isLight
          ? '#ffffff'
          : '#111827';

        const borderColor = isLight
          ? 'rgba(0,0,0,0.08)'
          : 'rgba(255,255,255,0.08)';

        const contentBg = isLight
          ? 'rgba(0,0,0,0.04)'
          : 'rgba(255,255,255,0.04)';

        const lineBg = isLight
          ? 'rgba(0,0,0,0.08)'
          : 'rgba(255,255,255,0.08)';

        previewCards.forEach(card => {
          card.style.background =
            cardBg;

          card.style.borderColor =
            borderColor;
        });

        previewContents.forEach(el => {
          el.style.background =
            contentBg;
          el.style.borderColor =
            borderColor;
        });
        previewLines.forEach(line => {
          line.style.background =
            lineBg;
        });
        // avatar
        document
          .querySelectorAll(
            '.preview-avatar',
          )
          .forEach(el => {
            el.style.background =
              color;
          });
        // button
        document
          .querySelectorAll(
            '.preview-button',
          )
          .forEach(el => {
            el.style.background = `
              linear-gradient(
                135deg,
                ${color},
                ${shadeColor(color, -20)}
              )
            `;
            el.style.color = '#fff';
          });
      }

      function updateAll() {
        const color =
          colorInput.value;
        const theme =
          themeSelect.value;
        document.documentElement.style.setProperty(
          '--primary',
          color,
        );
        colorDot.style.background =
          color;
        colorText.textContent = color;
        applyPreviewTheme(
          theme,
          color,
        );
      }
      // realtime color
      colorInput?.addEventListener(
        'input',
        updateAll,
      );
      // realtime theme mode
      themeSelect?.addEventListener(
        'change',
        updateAll,
      );
      // init
      updateAll();
    },
  );
</script>