<div class="task-user-page">
  <!-- HEADER -->
  <div
    class="task-user-header page-header d-flex justify-content-between align-items-center mb-4"
  >
    <div>
      <h2 class="mb-1">My Tasks</h2>
      <p class="text-muted mb-0">Manage your personal tasks</p>
    </div>

    <form method="GET" class="task-user-filter">
      <div class="task-user-filter-group">
        <i class="bi bi-search"></i>
        <input
          type="text"
          name="keyword"
          placeholder="Search task..."
          value="{{activeFilter.keyword}}"
        />
      </div>

      <div class="task-user-filter-group">
        <i class="bi bi-funnel"></i>
        <select name="status">
          <option value="">All Status</option>
          <option value="pending">Pending</option>
          <option value="done">Done</option>
          <option value="soon">Soon</option>
          <option value="overdue">Overdue</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Filter</button>
    </form>
  </div>

  <!-- TABLE -->
  <div class="card task-user-card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table task-user-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Deadline</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {{#if tasks.length}} {{#each tasks}}
            <tr>
              <td>
                <a href="/tasks/{{_id}}" class="task-user-link"> {{title}} </a>
              </td>
              <td>
                {{#if isOverdue}}
                <span class="task-user-badge badge-danger">Overdue</span>
                {{else if isSoon}}
                <span class="task-user-badge badge-warning">Soon</span>
                {{else ifCond status '===' 'done'}}
                <span class="task-user-badge badge-success">Done</span>
                {{else}}
                <span class="task-user-badge badge-secondary">Pending</span>
                {{/if}}
              </td>
              <td>{{formatDate deadline}}</td>
              <td>
                <div class="task-user-action-group">
                  <form
                    method="POST"
                    action="/tasks/{{_id}}/status?_method=PATCH"
                  >
                    <button class="btn btn-sm btn-success">
                      {{#if (eq status "done")}} Undo {{else}} Done {{/if}}
                    </button>
                  </form>
                  <a href="/tasks/{{_id}}/edit" class="btn btn-sm btn-warning">
                    Edit
                  </a>
                  <form method="POST" action="/tasks/{{_id}}?_method=DELETE">
                    <button class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            {{/each}} {{else}}
            <tr>
              <td colspan="4" class="text-center py-5 text-muted">
                No tasks found
              </td>
            </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
