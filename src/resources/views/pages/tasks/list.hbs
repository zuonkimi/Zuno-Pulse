<div class="task-list-container">
  <!-- HEADER -->
  <div class="task-list-header">
    <div>
      <h2>Task Management</h2>
      <small> Manage all your tasks </small>
    </div>

    <a href="/tasks/create" class="btn btn-primary">
      <i class="bi bi-plus-lg"></i>
      Create Task
    </a>
  </div>

  <!-- FILTER -->
  <div class="filter-bar">
    <a href="/tasks" class="filter-item"> All </a>

    <a href="/tasks?filter=soon" class="filter-item"> Soon </a>

    <a href="/tasks?filter=overdue" class="filter-item"> Overdue </a>

    <a href="/tasks?filter=done" class="filter-item"> Done </a>

    <a href="/me/trash-tasks" class="filter-item"> Trash </a>
  </div>

  <!-- TASK LIST -->
  <div class="task-list">
    {{#each tasks}}

    <div class="task-card card">
      <div class="card-body">
        <!-- TOP -->
        <div class="task-top">
          <div>
            <h5 class="task-title">
              <a href="/tasks/{{_id}}"> {{title}} </a>
            </h5>

            {{#if description}}
            <p class="task-desc">{{description}}</p>
            {{/if}}
          </div>

          <span class="status {{status}}"> {{status}} </span>
        </div>

        <!-- META -->
        <div class="task-meta">
          <span>
            <i class="bi bi-calendar-event-fill"></i>
            {{formatDate deadline}}
          </span>
        </div>

        <!-- ACTION -->
        <div class="task-actions">
          <form method="POST" action="/tasks/{{_id}}/status?_method=PATCH">
            <button class="task-btn task-btn-success">
              <i class="bi bi-check-circle-fill"></i>

              {{#if (eq status "done")}} Undo {{else}} Done {{/if}}
            </button>
          </form>

          <a href="/tasks/{{_id}}/edit" class="task-btn task-btn-warning">
            <i class="bi bi-pencil-square"></i>
            Edit
          </a>

          <form method="POST" action="/tasks/{{_id}}?_method=DELETE">
            <button class="task-btn task-btn-danger">
              <i class="bi bi-trash-fill"></i>
              Delete
            </button>
          </form>
        </div>
      </div>
    </div>

    {{else}}

    <div class="empty-state">
      <h5>No tasks found</h5>

      <small> Try changing filter or create a new task </small>
    </div>

    {{/each}}
  </div>
</div>
