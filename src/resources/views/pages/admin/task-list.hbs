<div class="admin-page">
  <div
    class="page-header d-flex justify-content-between align-items-center mb-4"
  >
    <div>
      <h2 class="mb-1">Task Management</h2>
      <p class="text-muted mb-0">Manage tasks from all users</p>
    </div>

    <form method="GET" class="admin-filter">
      <div class="admin-filter-group">
        <i class="bi bi-search"></i>

        <input
          type="text"
          name="keyword"
          placeholder="Search task..."
          value="{{activeFilter.keyword}}"
        />
      </div>

      <div class="admin-filter-group">
        <i class="bi bi-funnel"></i>
        <select name="status">
          <option value="" {{selected "" activeFilter.status}}>All Status</option>
          <option value="pending" {{selected "pending" activeFilter.status}}>Pending</option>
          <option value="done" {{selected "done" activeFilter.status}}>Done</option>
          <option value="soon" {{selected "soon" activeFilter.status}}>Soon</option>
          <option value="overdue" {{selected "overdue" activeFilter.status}}>Overdue</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">
        <i class="bi bi-search"></i>
        Filter
      </button>
    </form>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Title</th>
              <th>Status</th>
              <th>Deadline</th>
              <th>Likes</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {{#if tasks.length}} {{#each tasks}}
            <tr>
              <td>
                <div class="user-name">{{author.name}}</div>
              </td>
              <td>
                <a href="/admin/tasks/{{_id}}" class="task-link"> {{title}} </a>
              </td>
              <td>
                {{#if isOverdue}}
                <span class="admin-badge badge-danger"> Overdue </span>
                {{else if isSoon}}
                <span class="admin-badge badge-warning"> Soon </span>
                {{else ifCond status '===' 'done'}}
                <span class="admin-badge badge-success"> Done </span>
                {{else}}
                <span class="admin-badge badge-secondary"> Pending </span>
                {{/if}}
              </td>
              <td>{{formatDate deadline}}</td>
              <td>{{likeCount}}</td>
              <td>
                <div class="admin-action-group">
                  <form
                    method="POST"
                    action="/admin/tasks/{{_id}}/status?_method=PATCH"
                  >
                    <button class="btn btn-sm btn-success">
                      {{#if (eq status "done")}} Undo {{else}} Done {{/if}}
                    </button>
                  </form>
                  <a
                    href="/admin/tasks/{{_id}}/edit"
                    class="btn btn-sm btn-warning"
                  >
                    Edit
                  </a>
                  <form method="POST" action="/admin/tasks/{{_id}}/delete">
                    <button class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            {{/each}} {{else}}
            <tr>
              <td colspan="6" class="text-center py-5">
                <div class="text-muted">No tasks found</div>
              </td>
            </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
