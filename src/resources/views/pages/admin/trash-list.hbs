<div class="admin-page">
  <div
    class="page-header d-flex justify-content-between align-items-center mb-4"
  >
    <div>
      <h2 class="mb-1">Trash Tasks</h2>
      <p class="text-muted mb-0">Deleted tasks from all users</p>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Task</th>
              <th>Deleted At</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {{#if tasks.length}} {{#each tasks}}
            <tr>
              <td>
                <div class="fw-semibold user-name">{{author.name}}</div>
              </td>
              <td>
                <div class="task-title">{{title}}</div>
              </td>
              <td>{{formatDate updatedAt}}</td>

              <td>
                <div class="admin-action-group">
                  <!-- RESTORE -->
                  <form method="POST" action="/admin/tasks/{{_id}}/restore">
                    <button type="submit" class="btn btn-sm btn-success">
                      Restore
                    </button>
                  </form>
                  <!-- FORCE DELETE -->
                  <form
                    method="POST"
                    action="/admin/tasks/{{_id}}/force"
                    class="force-delete-form"
                    data-task-title="{{title}}"
                  >
                    <button type="submit" class="btn btn-sm btn-danger">
                      Delete Forever
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            {{/each}} {{else}}
            <tr>
              <td colspan="4" class="text-center py-5">
                <div class="text-muted">No deleted tasks found</div>
              </td>
            </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- CUSTOM CONFIRM MODAL -->
<div class="confirm-modal" id="confirmModal">
  <div class="confirm-modal-box">
    <div class="confirm-modal-icon">
      <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <h4 class="confirm-modal-title">Delete permanently?</h4>
    <p class="confirm-modal-text" id="confirmModalText">
      This action cannot be undone.
    </p>
    <div class="confirm-modal-actions">
      <button
        type="button"
        class="btn-confirm btn-confirm-cancel"
        id="confirmCancelBtn"
      >
        Cancel
      </button>
      <button
        type="button"
        class="btn-confirm btn-confirm-danger"
        id="confirmOkBtn"
      >
        Delete Forever
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('confirmModal');
    const modalText = document.getElementById('confirmModalText');
    const cancelBtn = document.getElementById('confirmCancelBtn');
    const okBtn = document.getElementById('confirmOkBtn');
    let pendingForm = null;
    document.querySelectorAll('.force-delete-form').forEach(form => {
      form.addEventListener('submit', e => {
        e.preventDefault();
        pendingForm = form;
        const title = form.dataset.taskTitle || 'this task';
        modalText.textContent = `"${title}" will be permanently deleted. This action cannot be undone.`;
        modal.classList.add('active');
      });
    });
    function closeModal() {
      modal.classList.remove('active');
      pendingForm = null;
    }
    cancelBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', e => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modal.classList.contains('active'))
        closeModal();
    });
    okBtn.addEventListener('click', () => {
      if (pendingForm) {
        okBtn.disabled = true;
        pendingForm.submit();
      }
    });
  })();
</script>
