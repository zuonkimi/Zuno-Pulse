# ==============================
# SERVER
# ==============================
PORT=9999

# ==============================
# DATABASE (MongoDB Atlas)
# ==============================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# ==============================
# SESSION
# ==============================
# Random long string used to sign the session cookie
SESSION_SECRET=your_session_secret_here

# ==============================
# EMAIL (Nodemailer - used for verification & password reset emails)
# ==============================
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password

# ==============================
# GOOGLE OAUTH LOGIN
# ==============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_SECRET_ID=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:9999/auth/google/callback

# ==============================
# FACEBOOK OAUTH LOGIN
# ==============================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URL=http://localhost:9999/auth/facebook/callback

# ==============================
# LINE OAUTH LOGIN
# ==============================
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_REDIRECT_URL=http://localhost:9999/auth/line/callback
